    {
      "id": "ACC-001",
      "description": "Portable startup: verify the tool starts in a fresh Windows sandbox, scans 3 text files, and produces a bounded conclusion.",
      "linkedReqs": ["REQ-001"],
      "linkedAcs": ["AC-001"],
      "linkedSrsFs": ["SRS-F-001"],
      "linkedVts": ["VT-001"],
      "requiredOsCapability": "windows-sandbox",
      "maxDurationMs": 30000,
      "maxMemoryMb": 512,
      "variableFields": ["uuid", "timestamp", "tempPath"],
      "syntheticInput": {
        "description": "3 healthy text files, mock LLM returning confirmed",
        "fileCount": 3,
        "useMockLlm": true,
        "mockLlmOutcome": "confirmed"
      },
      "expectedScan": {
        "status": "Completed"
      },
      "expectedConclusion": {
        "isBounded": true
      }
    },
    {
      "id": "ACC-002",
