      "linkedVts": ["VT-002"],
      "requiredOsCapability": "windows-sandbox",
      "maxDurationMs": 5000,
      "maxMemoryMb": 512,
      "variableFields": ["uuid", "timestamp", "tempPath"],
      "syntheticInput": {
        "description": "0 files — cold start timing only",
        "fileCount": 0
      },
      "expectedScan": {
        "status": "Completed"
      }
    },
