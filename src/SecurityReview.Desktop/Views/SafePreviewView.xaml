<UserControl x:Class="SecurityReview.Desktop.Views.SafePreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:SecurityReview.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SafePreviewViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="{Binding PreviewTitle}"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushTextPrimary}"
                   Margin="0,0,0,4"/>

        <!-- Truncation note -->
        <Border Grid.Row="1"
                Background="{StaticResource BrushSurface1}"
                Padding="8,4" CornerRadius="4" Margin="0,0,0,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TruncationNote}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TruncationNote}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding TruncationNote}"
                       Foreground="{StaticResource BrushWarn}"
                       FontSize="12"/>
        </Border>

        <!-- =========================================================== -->
        <!-- Text Preview Mode -->
        <!-- =========================================================== -->
        <Grid Grid.Row="2"
              Visibility="{Binding IsTextPreview, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding LocatorInfo}"
                       FontSize="12"
                       Foreground="{StaticResource BrushTextSecondary}"
                       Margin="0,0,0,4"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding TextLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="2,1" CornerRadius="2"
                                    Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding LineNumber}"
                                               FontFamily="Consolas" FontSize="12"
                                               Foreground="{StaticResource BrushTextDisabled}"
                                               Margin="0,0,8,0"
                                               TextAlignment="Right"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Text}"
                                               FontFamily="Consolas" FontSize="12"
                                               Foreground="{StaticResource BrushTextPrimary}"
                                               TextWrapping="NoWrap"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- =========================================================== -->
        <!-- Table Preview Mode -->
        <!-- =========================================================== -->
        <Grid Grid.Row="2"
              Visibility="{Binding IsTablePreview, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding LocatorInfo}"
                       FontSize="12"
                       Foreground="{StaticResource BrushTextSecondary}"
                       Margin="0,0,0,4"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding TableRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="3,2" CornerRadius="2"
                                    BorderBrush="{StaticResource BrushSurface2}"
                                    BorderThickness="0,0,0,1">
                                <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="6,2" Margin="1,0"
                                                    BorderBrush="{StaticResource BrushSurface3}"
                                                    BorderThickness="1"
                                                    MinWidth="80">
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Consolas" FontSize="12"
                                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- =========================================================== -->
        <!-- Binary Preview Mode -->
        <!-- =========================================================== -->
        <Grid Grid.Row="2"
              Visibility="{Binding IsBinaryPreview, Converter={StaticResource BooleanToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                       Text="{Binding LocatorInfo}"
                       FontSize="12"
                       Foreground="{StaticResource BrushTextSecondary}"
                       Margin="0,0,0,4"/>

            <Border Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding HexLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Offset, StringFormat={}{0:X8}}"
                                               FontFamily="Consolas" FontSize="12"
                                               Foreground="{StaticResource BrushTextDisabled}"
                                               Width="70" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Hex}"
                                               FontFamily="Consolas" FontSize="12"
                                               Foreground="{StaticResource BrushTextPrimary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Row="1" Grid.Column="1" Width="4"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource BrushSurface2}"/>

            <Border Grid.Row="1" Grid.Column="2" Margin="4,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding TextLinesOnly}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Empty state -->
        <TextBlock Grid.Row="2" Text="暂无预览内容。"
                   FontSize="14"
                   Foreground="{StaticResource BrushTextSecondary}"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasContent}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
