<UserControl x:Class="SecurityReview.Desktop.Views.LlmSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:SecurityReview.Desktop.ViewModels"
             xmlns:llm="clr-namespace:SecurityReview.Domain.Llm;assembly=SecurityReview.Domain"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:LlmSettingsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="AI ASSIST" Style="{StaticResource PageEyebrowStyle}" />
                <TextBlock Text="LLM 设置" Style="{StaticResource PageTitleStyle}" Margin="0,3,0,0" />
                <TextBlock Text="连接兼容端点以辅助结果分析。未配置时，核心规则扫描仍可独立运行。"
                           Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,0" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="连接配置" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="云上 API 强制 HTTPS；内网模型可使用受限 HTTP。"
                                   Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,18" />

                        <TextBlock Text="端点类型" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox SelectedValue="{Binding EndpointScope, Mode=TwoWay}"
                                  SelectedValuePath="Tag" Margin="0,0,0,8">
                            <ComboBoxItem Content="云上 API（HTTPS）"
                                          Tag="{x:Static llm:LlmEndpointScope.CloudApi}" />
                            <ComboBoxItem Content="内网 / 本机模型（HTTP 或 HTTPS）"
                                          Tag="{x:Static llm:LlmEndpointScope.PrivateNetwork}" />
                        </ComboBox>
                        <TextBlock Text="{Binding EndpointSecurityHint}"
                                   Style="{StaticResource PageSubtitleStyle}"
                                   TextWrapping="Wrap" Margin="0,0,0,15" />

                        <TextBlock Text="服务基地址" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding BaseUri, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,15" />

                        <TextBlock Text="模型标识" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,20" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="加载配置" Command="{Binding LoadCommand}" Margin="0,0,8,0" />
                            <Button Content="保存配置" Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" MinHeight="34" Padding="14,7" Margin="0,0,8,0" />
                            <Button Content="清除" Command="{Binding ClearCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource AccentSignalStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="连接测试" Style="{StaticResource SectionTitleStyle}" />
                                <Ellipse Grid.Column="1" Width="9" Height="9" Fill="{StaticResource BrushAccent}"
                                         VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding LastTestStatus}" FontFamily="Bahnschrift SemiBold"
                                       FontSize="20" Margin="0,12,0,10" />
                            <Border Background="#70FFFFFF" CornerRadius="5" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="上次测试端点" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding LastTestOrigin}" Style="{StaticResource MonoTextStyle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LastTestTime}" FontSize="11"
                                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Button Content="测试当前连接  →" Command="{Binding TestCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <TextBlock Text="测试请求不会携带扫描发现或敏感内容。"
                               Style="{StaticResource PageSubtitleStyle}" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
