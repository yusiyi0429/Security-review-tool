<UserControl x:Class="SecurityReview.Desktop.Views.ScanProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:SecurityReview.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ScanProgressViewModel}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Current Stage -->
        <Border Grid.Row="0" Padding="12" CornerRadius="6" Margin="0,0,0,12"
                Background="#E8F0FE">
            <StackPanel>
                <TextBlock Text="扫描状态" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="{Binding StageDisplay}" FontSize="24"
                           Foreground="#1A56DB" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Progress Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ProgressBar Grid.Row="0" Value="{Binding ProgressPercentage}"
                         Minimum="0" Maximum="100" Height="24"/>
            <TextBlock Grid.Row="1" Text="{Binding ProgressPercentage, StringFormat='{}{0:F1}%'}"
                       HorizontalAlignment="Center" Margin="0,4,0,0"
                       FontSize="14" FontWeight="SemiBold"/>
        </Grid>

        <!-- Detail Counts -->
        <GroupBox Grid.Row="2" Header="进度详情" Margin="0,0,0,12">
            <UniformGrid Columns="3" Rows="4">
                <StackPanel Margin="4">
                    <TextBlock Text="阶段" Foreground="Gray" FontSize="11"/>
                    <TextBlock Text="{Binding StageDisplay}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="已发现" Foreground="Gray" FontSize="11"/>
                    <TextBlock Text="{Binding DiscoveredFiles}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="已处理" Foreground="Gray" FontSize="11"/>
                    <TextBlock Text="{Binding ProcessedFiles}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="失败" Foreground="Gray" FontSize="11"/>
                    <TextBlock Text="{Binding FailedFiles}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="已处理字节 / 计划" Foreground="Gray" FontSize="11"/>
                    <TextBlock FontWeight="SemiBold">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:N0} / {1:N0}">
                                <Binding Path="ProcessedBytes"/>
                                <Binding Path="PlannedBytes"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="归档条目" Foreground="Gray" FontSize="11"/>
                    <TextBlock Text="{Binding ArchiveEntryCount}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="活动 Worker" Foreground="Gray" FontSize="11"/>
                    <TextBlock Text="{Binding ActiveWorkerCount}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="发现计数" Foreground="Gray" FontSize="11"/>
                    <TextBlock Text="{Binding FindingCount}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="LLM 队列" Foreground="Gray" FontSize="11"/>
                    <TextBlock Text="{Binding LlmQueueCount}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="当前文件序号" Foreground="Gray" FontSize="11"/>
                    <TextBlock Text="{Binding CurrentFileOrdinal}" FontWeight="SemiBold"/>
                </StackPanel>
            </UniformGrid>
        </GroupBox>

        <!-- Stage Log -->
        <GroupBox Grid.Row="3" Header="阶段日志" Margin="0,0,0,12">
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding StageLog}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="12" Margin="2,1,2,1">
                                <Run Text="{Binding Stage, Mode=OneWay}"
                                     FontWeight="SemiBold"/>
                                <Run Text=" " Foreground="Gray"/>
                                <Run Text="{Binding Description, Mode=OneWay}" Foreground="Gray"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>

        <!-- Cancel Button -->
        <Grid Grid.Row="4">
            <Button Content="{Binding CancelButtonText}"
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding CancelEnabled}"
                    Padding="16,8" FontSize="16" HorizontalAlignment="Center"
                    MinWidth="160"
                    Foreground="White">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#DC3545"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CancelEnabled}" Value="False">
                                <Setter Property="Background" Value="Gray"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
