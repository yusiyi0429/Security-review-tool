<UserControl x:Class="SecurityReview.Desktop.Views.CoverageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:SecurityReview.Desktop.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:CoverageViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="DIAGNOSTICS" Style="{StaticResource PageEyebrowStyle}" />
            <TextBlock Text="诊断与覆盖" Style="{StaticResource PageTitleStyle}" Margin="0,3,0,0" />
            <TextBlock Text="核查扫描覆盖边界、未处理原因与文件级诊断信息。"
                       Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,0,0,16">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AccentSignalStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsComplete}" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushOkSoft}" />
                            <Setter Property="BorderBrush" Value="#B7E0D3" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="覆盖结论" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock FontFamily="Bahnschrift SemiBold" FontSize="21">
                        <Run Text="{Binding ScanStatusDisplay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding ConclusionHeader}" Style="{StaticResource PageSubtitleStyle}"
                               Margin="0,5,24,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="覆盖缺口" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Text="{Binding TotalGaps}" FontFamily="Bahnschrift SemiBold" FontSize="28"
                               Foreground="{StaticResource BrushWarn}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="文件总数" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Text="{Binding TotalFiles}" FontFamily="Bahnschrift SemiBold" FontSize="28"
                               Foreground="{StaticResource BrushAccentHover}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="覆盖缺口">
                <Border Style="{StaticResource CardStyle}" CornerRadius="0,8,8,8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="未覆盖项按处理阶段与诊断代码归类" Style="{StaticResource PageSubtitleStyle}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="上一页" Command="{Binding PreviousGapPageCommand}"
                                        IsEnabled="{Binding HasPreviousGapPage}" Margin="0,0,8,0" />
                                <TextBlock VerticalAlignment="Center" Margin="4,0,12,0">
                                    <Run Text="第 " /><Run Text="{Binding CurrentGapPage}" />
                                    <Run Text=" / " /><Run Text="{Binding TotalGapPages}" /><Run Text=" 页" />
                                </TextBlock>
                                <Button Content="下一页" Command="{Binding NextGapPageCommand}"
                                        IsEnabled="{Binding HasNextGapPage}" />
                            </StackPanel>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Gaps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InsetCardStyle}" Margin="0,0,0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="1.6*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="4" CornerRadius="2" Background="{StaticResource BrushWarn}" />
                                                <StackPanel Grid.Column="1" Margin="9,0,14,0">
                                                    <TextBlock Text="{Binding ReasonDisplay}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding StageDisplay}" Style="{StaticResource PageSubtitleStyle}"
                                                               FontSize="11" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding DetailCode}" Style="{StaticResource MonoTextStyle}" />
                                                    <TextBlock Text="{Binding HelpText}" Style="{StaticResource PageSubtitleStyle}"
                                                               FontSize="11" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="文件列表">
                <Border Style="{StaticResource CardStyle}" CornerRadius="0,8,8,8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="路径已按隐私规则脱敏显示" Style="{StaticResource PageSubtitleStyle}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="上一页" Command="{Binding PreviousFilePageCommand}"
                                        IsEnabled="{Binding HasPreviousFilePage}" Margin="0,0,8,0" />
                                <TextBlock VerticalAlignment="Center" Margin="4,0,12,0">
                                    <Run Text="第 " /><Run Text="{Binding CurrentFilePage}" />
                                    <Run Text=" / " /><Run Text="{Binding TotalFilePages}" /><Run Text=" 页" />
                                </TextBlock>
                                <Button Content="下一页" Command="{Binding NextFilePageCommand}"
                                        IsEnabled="{Binding HasNextFilePage}" />
                            </StackPanel>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BrushSurface2}" BorderThickness="0,0,0,1"
                                                Padding="8,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="180" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding RedactedPath}" FontFamily="Cascadia Mono" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding ReasonDisplay}"
                                                           Foreground="{StaticResource BrushTextSecondary}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
