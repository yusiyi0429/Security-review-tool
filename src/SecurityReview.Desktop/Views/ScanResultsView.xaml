<UserControl x:Class="SecurityReview.Desktop.Views.ScanResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:SecurityReview.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ScanResultsViewModel}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <!-- Header: Status & Conclusion -->
        <Border Grid.Row="0" Padding="12" CornerRadius="6" Margin="0,0,0,8"
                Background="#E8F0FE">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="Bold">
                    <Run Text="扫描结果 · "/>
                    <Run Text="{Binding ScanStatusDisplay}"/>
                </TextBlock>
                <TextBlock Text="{Binding ConclusionDisplay}" FontSize="14"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Filters -->
        <GroupBox Grid.Row="1" Header="筛选器" Margin="0,0,0,8">
            <StackPanel>
                <UniformGrid Columns="6" Margin="0,0,0,8">
                    <StackPanel Margin="2">
                        <TextBlock Text="类别" FontSize="11" Foreground="Gray"/>
                        <ComboBox SelectedItem="{Binding FilterKind}"
                                  ItemsSource="{x:Static vm:FilterLists.FindingKinds}"/>
                    </StackPanel>
                    <StackPanel Margin="2">
                        <TextBlock Text="严重级别" FontSize="11" Foreground="Gray"/>
                        <ComboBox SelectedItem="{Binding FilterSeverity}"
                                  ItemsSource="{x:Static vm:FilterLists.Severities}"/>
                    </StackPanel>
                    <StackPanel Margin="2">
                        <TextBlock Text="置信度" FontSize="11" Foreground="Gray"/>
                        <ComboBox SelectedItem="{Binding FilterConfidence}"
                                  ItemsSource="{x:Static vm:FilterLists.Confidences}"/>
                    </StackPanel>
                    <StackPanel Margin="2">
                        <TextBlock Text="资产类型" FontSize="11" Foreground="Gray"/>
                        <TextBox Text="{Binding FilterAssetType, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="2">
                        <TextBlock Text="复核状态" FontSize="11" Foreground="Gray"/>
                        <ComboBox SelectedItem="{Binding FilterReviewStatus}"
                                  ItemsSource="{x:Static vm:FilterLists.ReviewStatuses}"/>
                    </StackPanel>
                    <StackPanel Margin="2">
                        <TextBlock Text="差异状态" FontSize="11" Foreground="Gray"/>
                        <ComboBox SelectedItem="{Binding FilterDifferenceStatus}"
                                  ItemsSource="{x:Static vm:FilterLists.DifferenceStatuses}"/>
                    </StackPanel>
                </UniformGrid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="应用筛选" Command="{Binding ApplyFilterCommand}"
                            Padding="10,4" Margin="0,0,8,0"/>
                    <Button Content="清除筛选" Command="{Binding ClearFiltersCommand}"
                            Padding="10,4"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Pagination -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="上一页" Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding HasPreviousPage}"
                        Padding="8,4" Margin="0,0,8,0"/>
                <TextBlock VerticalAlignment="Center" Margin="4,0">
                    <Run Text="第 "/>
                    <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                    <Run Text=" 页 · 共 "/>
                    <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                    <Run Text=" 页 ("/>
                    <Run Text="{Binding TotalGroups, Mode=OneWay}"/>
                    <Run Text=" 个发现组)"/>
                </TextBlock>
                <Button Content="下一页" Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding HasNextPage}"
                        Padding="8,4" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Groups List -->
        <GroupBox Grid.Row="3" Header="发现组" Margin="0,0,0,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="LightGray" BorderThickness="1"
                                    Padding="10,6" Margin="0,0,0,4" CornerRadius="4"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="GroupItem_Click">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding KindDisplay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding SeverityDisplay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="指纹: " Foreground="Gray" FontSize="12"/>
                                        <TextBlock Text="{Binding ShortFingerprint}"
                                                   FontFamily="Consolas" FontSize="12"
                                                   Foreground="Gray"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding OccurrenceCount, StringFormat='{}{0} 个出现'}"
                                               Foreground="Gray" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>

        <!-- Occurrence Detail Pane -->
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="出现列表" Margin="0,0,4,0">
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ExpandedOccurrences}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightGray" BorderThickness="1"
                                        Padding="6,3" Margin="0,0,0,2" CornerRadius="3"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="OccurrenceItem_Click">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayPath}"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding DisplayLocator}"
                                                   FontSize="11" Foreground="Gray"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="发现详情" Margin="4,0,0,0">
                <StackPanel>
                    <TextBlock Text="值:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DecryptedValue, Mode=OneWay}"
                             IsReadOnly="True" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="13"
                             Background="#F5F5F5" BorderBrush="LightGray"
                             MaxHeight="100" VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,8"/>
                    <TextBlock Text="上下文:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DecryptedContext, Mode=OneWay}"
                             IsReadOnly="True" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="13"
                             Background="#F5F5F5" BorderBrush="LightGray"
                             MaxHeight="150" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
