<UserControl x:Class="SecurityReview.Desktop.Views.ScanResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:SecurityReview.Desktop.ViewModels"
             xmlns:views="clr-namespace:SecurityReview.Desktop.Views"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ScanResultsViewModel}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="ASSESSMENT RESULT" Style="{StaticResource PageEyebrowStyle}" />
                <TextBlock Style="{StaticResource PageTitleStyle}" Margin="0,3,0,0">
                    <Run Text="扫描结果 / " /><Run Text="{Binding ScanStatusDisplay, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding ConclusionDisplay}" Style="{StaticResource PageSubtitleStyle}"
                           Margin="0,5,20,0" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource WarningSignalStyle}" Padding="14,10"
                    VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding TotalGroups}" FontFamily="Bahnschrift SemiBold" FontSize="20"
                               Foreground="{StaticResource BrushWarn}" VerticalAlignment="Center" />
                    <TextBlock Text="  个发现组" Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <UniformGrid Columns="2" Margin="0,0,14,0">
                    <StackPanel Margin="0,0,7,0">
                        <TextBlock Text="类别" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox SelectedItem="{Binding FilterKind}" ItemsSource="{x:Static vm:FilterLists.FindingKinds}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,7,0">
                        <TextBlock Text="严重级别" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox SelectedItem="{Binding FilterSeverity}" ItemsSource="{x:Static vm:FilterLists.Severities}" />
                    </StackPanel>
                </UniformGrid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="清除" Command="{Binding ClearFiltersCommand}" MinWidth="62" Margin="0,0,7,0" />
                    <Button Content="应用" Command="{Binding ApplyFilterCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" MinHeight="34" MinWidth="66" Padding="14,7" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Background="{StaticResource BrushSurface0}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="发现组" Style="{StaticResource SectionTitleStyle}"
                                   Margin="16,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Button Content="‹" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding HasPreviousPage}"
                                    MinWidth="36" Padding="8,5" Margin="0,0,7,0" />
                            <TextBlock VerticalAlignment="Center" Margin="3,0,10,0" FontSize="12">
                                <Run Text="{Binding CurrentPage, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding TotalPages, Mode=OneWay}" />
                            </TextBlock>
                            <Button Content="›" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}"
                                    MinWidth="36" Padding="8,5" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Groups}" Margin="10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushSurface1}"
                                            BorderBrush="{StaticResource BrushSurface2}" BorderThickness="1"
                                            CornerRadius="6" Padding="12,10" Margin="0,0,0,7"
                                            Cursor="Hand" MouseLeftButtonUp="GroupItem_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="4" CornerRadius="2" Background="{StaticResource BrushWarn}" />
                                            <StackPanel Grid.Column="1" Margin="9,0,10,0">
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="{Binding KindDisplay, Mode=OneWay}" /><Run Text="  /  " Foreground="{StaticResource BrushTextDisabled}" />
                                                    <Run Text="{Binding SeverityDisplay, Mode=OneWay}" Foreground="{StaticResource BrushError}" />
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <TextBlock Text="FP  " FontFamily="Bahnschrift SemiBold" FontSize="10"
                                                               Foreground="{StaticResource BrushTextDisabled}" />
                                                    <TextBlock Text="{Binding ShortFingerprint}" Style="{StaticResource MonoTextStyle}" FontSize="11" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{StaticResource BrushWarnSoft}" CornerRadius="10"
                                                    Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding OccurrenceCount, StringFormat='{}{0} 处'}" FontSize="11"
                                                           FontWeight="SemiBold" Foreground="{StaticResource BrushWarn}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.9*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="1.1*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="出现位置" Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" Margin="15,0" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ExpandedOccurrences}" Margin="10,4,10,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BrushSurface2}" BorderThickness="0,0,0,1"
                                                Padding="5,8" Cursor="Hand" MouseLeftButtonUp="OccurrenceItem_Click">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayPath}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DisplayLocator}" Style="{StaticResource MonoTextStyle}"
                                                           FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <views:FindingDetailView DataContext="{Binding Detail}" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
