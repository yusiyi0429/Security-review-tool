<UserControl x:Class="SecurityReview.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:SecurityReview.Desktop.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="AUDIT TRAIL" Style="{StaticResource PageEyebrowStyle}" />
                <TextBlock Text="任务历史" Style="{StaticResource PageTitleStyle}" Margin="0,3,0,0" />
                <TextBlock Text="回看已保存的扫描结论、发现组和出现位置，或清理不再需要的任务记录。"
                           Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="刷新记录" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Button Content="删除记录" Command="{Binding DeleteCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource AccentSignalStyle}" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="i" FontFamily="Bahnschrift SemiBold" FontSize="13"
                           Foreground="{StaticResource BrushAccentHover}" Margin="0,0,9,0" />
                <TextBlock Grid.Column="1"
                           Text="点击“查看回放”可只读查看扫描结果，不会重新执行扫描；选择记录后可删除其关联数据。"
                           Foreground="{StaticResource BrushAccentHover}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Background="{StaticResource BrushSurface0}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="扫描任务 / 创建时间" Style="{StaticResource FieldLabelStyle}"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,5,0,0" />
                    <TextBlock Grid.Column="1" Text="风险摘要" Style="{StaticResource FieldLabelStyle}"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,5,12,0" />
                    <TextBlock Grid.Column="2" Text="操作" Style="{StaticResource FieldLabelStyle}"
                               FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Margin="0,5,12,0" />
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding Scans}"
                         SelectedItem="{Binding SelectedScan, Mode=TwoWay}"
                         Margin="12,10" Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BrushSurface2}" BorderThickness="0,0,0,1"
                                        Padding="7,12" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="4" Height="28" CornerRadius="2" Background="{StaticResource BrushAccent}"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold" FontSize="14">
                                                <Run Text="{Binding CreatedAtDisplay, Mode=OneWay}" />
                                                <Run Text="  /  " Foreground="{StaticResource BrushTextDisabled}" />
                                                <Run Text="{Binding StatusDisplay, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="本地安全扫描记录" Style="{StaticResource PageSubtitleStyle}"
                                                       FontSize="11" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding RiskSummary}" FontSize="12"
                                                   Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Content="查看回放"
                                                Command="{Binding DataContext.ViewScanCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                MinWidth="76" Padding="10,5" Margin="8,0,4,0"
                                                VerticalAlignment="Center"
                                                ToolTip="只读查看本次扫描的结论、发现组和出现位置" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
