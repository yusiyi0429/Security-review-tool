<UserControl x:Class="SecurityReview.Desktop.Views.NewScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:SecurityReview.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NewScanViewModel}"
             AllowDrop="True" Loaded="UserControl_Loaded"
             Drop="UserControl_Drop" DragOver="UserControl_DragOver">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="NEW ASSESSMENT" Style="{StaticResource PageEyebrowStyle}" />
                    <TextBlock Text="创建安全扫描" Style="{StaticResource PageTitleStyle}" Margin="0,3,0,0" />
                    <TextBlock Text="选择待检测资产，确认规则与排除项后启动本地扫描。"
                               Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource AccentSignalStyle}"
                        Padding="13,10" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●" Foreground="{StaticResource BrushAccent}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="拖放文件或目录即可添加" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushAccentHover}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Primary asset configuration -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="01 / 扫描目标" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="支持普通文件、目录、Docker TAR 与 OCI 布局目录"
                                               Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="选择文件" Command="{Binding PickFileCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Content="选择目录" Command="{Binding PickFolderCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" MinHeight="34" Padding="14,7" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource InsetCardStyle}" Padding="14,13">
                                <StackPanel>
                                    <TextBlock Text="将文件或目录拖到窗口任意位置"
                                               FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBlock Text="目标路径仅用于本机分析，不会写入外部服务日志。"
                                               Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding ScanTargets}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushSurface1}"
                                                BorderBrush="{StaticResource BrushSurface2}" BorderThickness="1"
                                                CornerRadius="6" Padding="12,9" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="4" CornerRadius="2" Background="{StaticResource BrushAccent}" />
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" Margin="9,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding KindDisplay}" FontSize="11"
                                                           Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="02 / 排除项" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="为无需检测的路径记录明确原因，便于后续审计。"
                                               Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="添加排除" Command="{Binding AddExclusionCommand}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ExclusionEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InsetCardStyle}" Margin="0,0,0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Entry.Pattern, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="路径或 Glob 模式" Margin="0,0,8,0" />
                                                <TextBox Grid.Column="1" Text="{Binding Entry.Reason, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="排除原因" Margin="0,0,8,0" />
                                                <Button Grid.Column="2" Content="移除"
                                                        Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" MinWidth="64" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Readiness and launch -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="扫描就绪状态" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="启动前检查" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,14" />

                            <Border Style="{StaticResource InsetCardStyle}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="资产清单" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding ManifestStatus}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="01" FontFamily="Bahnschrift SemiBold" FontSize="18"
                                               Foreground="{StaticResource BrushSurface3}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding ManifestSummary}" Style="{StaticResource PageSubtitleStyle}"
                                       Margin="2,0,2,12" />

                            <Border Style="{StaticResource InsetCardStyle}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="规则包" Style="{StaticResource FieldLabelStyle}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding RulePackVersion}" FontWeight="SemiBold" />
                                            <TextBlock Text=" · " Foreground="{StaticResource BrushTextDisabled}" />
                                            <TextBlock Text="{Binding RulePackStatus}" Foreground="{StaticResource BrushTextSecondary}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{StaticResource BrushOk}"
                                             VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding ActiveRuleWarning}" Foreground="{StaticResource BrushWarn}"
                                       FontSize="12" TextWrapping="Wrap" Margin="2,0,2,10"
                                       Visibility="{Binding HasOldRuleWarning, Converter={x:Static vm:BooleanConverters.BoolToVis}}" />

                            <Border Style="{StaticResource InsetCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="LLM 辅助分析" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding LlmStatus}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="OPTIONAL" FontFamily="Bahnschrift SemiBold" FontSize="9"
                                               Foreground="{StaticResource BrushTextDisabled}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding LlmWarning}" Foreground="{StaticResource BrushWarn}"
                                       FontSize="12" TextWrapping="Wrap" Margin="2,7,2,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource WarningSignalStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="扫描确认" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="存在排除项时，扫描状态将标记为「部分完成」。"
                                       Foreground="{StaticResource BrushWarn}" FontSize="12" Margin="0,5,0,10" TextWrapping="Wrap" />
                            <CheckBox Content="我已了解排除项可能影响结果完整性"
                                      IsChecked="{Binding ExclusionPartialAcknowledged}" />
                        </StackPanel>
                    </Border>

                    <Button Content="{Binding StartButtonText}" Command="{Binding StartScanCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" HorizontalContentAlignment="Center" />
                    <TextBlock Text="{Binding ScanReadinessMessage}"
                               Foreground="{StaticResource BrushWarn}"
                               FontSize="11" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Margin="0,8,0,0" />
                    <TextBlock Text="启动后可随时查看阶段进度并安全取消"
                               Style="{StaticResource PageSubtitleStyle}" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
