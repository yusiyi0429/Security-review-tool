<UserControl x:Class="SecurityReview.Desktop.Views.NewScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:SecurityReview.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NewScanViewModel}"
             AllowDrop="True"
             Drop="UserControl_Drop"
             DragOver="UserControl_DragOver">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Section: Scan Targets -->
            <GroupBox Grid.Row="0" Header="扫描目标" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="选择文件..." Command="{Binding PickFileCommand}"
                                Padding="10,4" Margin="0,0,8,0"/>
                        <Button Content="选择目录..." Command="{Binding PickFolderCommand}"
                                Padding="10,4"/>
                    </StackPanel>
                    <TextBlock Text="或将文件/目录拖放到此处。支持: 文件、目录、Docker TAR、OCI 布局目录。"
                               Foreground="Gray" FontSize="12" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding ScanTargets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightGray" BorderThickness="1"
                                        Padding="8,4" Margin="0,0,0,4" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding KindDisplay}"
                                                   Foreground="Gray" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </GroupBox>

            <!-- Section: Manifest -->
            <GroupBox Grid.Row="1" Header="资产清单" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding ManifestStatus}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ManifestSummary}" Foreground="Gray"
                               FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <!-- Section: Rule Pack & LLM Status -->
            <GroupBox Grid.Row="2" Header="规则包 &amp; LLM 状态" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="规则包: " FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RulePackVersion}"/>
                        <TextBlock Text=" (" />
                        <TextBlock Text="{Binding RulePackStatus}" />
                        <TextBlock Text=")" />
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveRuleWarning}"
                               Foreground="DarkOrange"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                               Visibility="{Binding HasOldRuleWarning, Converter={x:Static vm:BooleanConverters.BoolToVis}}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="LLM: " FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding LlmAvailable, StringFormat='{}{0:可用|不可用}'}" />
                    </StackPanel>
                    <TextBlock Text="{Binding LlmWarning}" Foreground="DarkOrange"
                               FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <!-- Section: Exclusions -->
            <GroupBox Grid.Row="3" Header="排除项" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="添加排除" Command="{Binding AddExclusionCommand}"
                                Padding="10,4" Margin="0,0,8,0"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding ExclusionEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightGray" BorderThickness="1"
                                        Padding="8,4" Margin="0,0,0,4" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding Entry.Pattern, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Entry.Reason, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,8,0"/>
                                        <Button Grid.Column="2" Content="删除"
                                                Command="{Binding DataContext.RemoveExclusionCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,4"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </GroupBox>

            <!-- Section: Partial Acknowledgement -->
            <GroupBox Grid.Row="4" Header="扫描确认" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="存在排除项时，扫描状态将为「部分完成」。"
                               Foreground="DarkOrange" Margin="0,0,0,4"
                               FontSize="12"/>
                    <CheckBox Content="我已了解排除项将导致扫描结果为「部分完成」，不保证完整性。"
                              IsChecked="{Binding ExclusionPartialAcknowledged}"
                              Margin="0,4,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Section: Start Button -->
            <Grid Grid.Row="5" Margin="0,12,0,0">
                <Button Content="开始扫描"
                        Command="{Binding StartScanCommand}"
                        Padding="16,8" FontSize="16" HorizontalAlignment="Center"
                        MinWidth="160"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
