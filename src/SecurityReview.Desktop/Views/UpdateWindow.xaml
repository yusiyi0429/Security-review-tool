<Window x:Class="SecurityReview.Desktop.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:SecurityReview.Desktop.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:UpdateViewModel}"
        Title="检查更新" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrushSurface0}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
  </Window.Resources>

  <Border Margin="20">
    <StackPanel>
      <TextBlock Text="软件更新" Style="{StaticResource SectionTitleStyle}" />
      <TextBlock Text="{Binding CurrentVersionDisplay}"
                 Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0" />

      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                 Foreground="{StaticResource BrushTextPrimary}" Margin="0,14,0,0" />

      <ProgressBar Value="{Binding DownloadPercent}" Minimum="0" Maximum="100"
                   IsIndeterminate="{Binding IsProgressIndeterminate}"
                   Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibility}}"
                   Height="6" Margin="0,12,0,0" />

      <TextBlock Text="便携版不提供自动安装，请前往发布页下载并手动更新。"
                 Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"
                 Foreground="{StaticResource BrushWarn}"
                 Visibility="{Binding ShowPortableHint, Converter={StaticResource BooleanToVisibility}}"
                 Margin="0,10,0,0" />

      <CheckBox Content="启动时自动检查更新"
                IsChecked="{Binding AutoCheckUpdatesOnStartup, Mode=TwoWay}"
                Margin="0,16,0,0" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="检查更新" Command="{Binding CheckCommand}"
                Padding="12,6" Margin="0,0,8,0" />
        <Button Content="打开发布页" Command="{Binding OpenReleasePageCommand}"
                Padding="12,6" Margin="0,0,8,0" />
        <Button Content="取消" Command="{Binding CancelCommand}"
                Padding="12,6" Margin="0,0,8,0" />
        <Button Content="下载并安装" Command="{Binding InstallCommand}"
                Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
