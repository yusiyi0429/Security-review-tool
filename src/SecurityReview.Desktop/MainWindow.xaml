<Window x:Class="SecurityReview.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SecurityReview.Desktop"
        xmlns:vm="clr-namespace:SecurityReview.Desktop.ViewModels"
        xmlns:views="clr-namespace:SecurityReview.Desktop.Views"
        mc:Ignorable="d"
        Title="安全审查工具"
        Icon="Assets/SecurityReviewTool.ico"
        MinWidth="960" MinHeight="600"
        Width="1280" Height="760"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        Foreground="{DynamicResource BrushTextPrimary}"
        Background="{DynamicResource BrushSurface0}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Strings.zh-CN.xaml" />
                <ResourceDictionary Source="Resources/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BrushSurface0}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <!-- Brand rail -->
        <Border Grid.RowSpan="2" Background="{StaticResource BrushShellGradient}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="22,24,18,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="#16FFFFFF">
                        <Image Source="Assets/SecurityReviewTool.png" Width="32" Height="32"
                               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="SECURITY REVIEW" FontFamily="Bahnschrift SemiBold"
                                   FontSize="14" Foreground="{StaticResource BrushTextOnDark}"
                                   />
                        <TextBlock Text="敏感信息监测工作台" FontSize="11"
                                   Foreground="{StaticResource BrushTextOnDarkMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="#20FFFFFF" Margin="18,0" />

                <StackPanel Grid.Row="2" Margin="0,18,0,0">
                    <TextBlock Text="WORKSPACE" FontFamily="Bahnschrift SemiBold" FontSize="10"
                               Foreground="#7390AA" Margin="26,0,0,8" />
                    <RadioButton GroupName="PrimaryNavigation" Style="{StaticResource NavButtonStyle}"
                                 Tag="01" IsChecked="True"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static local:Services.NavigationEntry.新建扫描}"
                                 Content="{StaticResource NavNewScan}" />
                    <RadioButton GroupName="PrimaryNavigation" Style="{StaticResource NavButtonStyle}"
                                 Tag="02" Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static local:Services.NavigationEntry.任务历史}"
                                 Content="{StaticResource NavTaskHistory}" />
                    <RadioButton GroupName="PrimaryNavigation" Style="{StaticResource NavButtonStyle}"
                                 Tag="03" Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static local:Services.NavigationEntry.规则管理}"
                                 Content="{StaticResource NavRuleManagement}" />
                    <RadioButton GroupName="PrimaryNavigation" Style="{StaticResource NavButtonStyle}"
                                 Tag="04" Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static local:Services.NavigationEntry.LLM设置}"
                                 Content="{StaticResource NavLlmSettings}" />
                    <RadioButton GroupName="PrimaryNavigation" Style="{StaticResource NavButtonStyle}"
                                 Tag="05" Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static local:Services.NavigationEntry.诊断与帮助}"
                                 Content="{StaticResource NavDiagnostics}" />
                </StackPanel>

                <Border Grid.Row="3" Margin="18,16,18,54" Padding="13,11"
                        CornerRadius="6" Background="#0F3555" BorderBrush="#1B4768" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="6" Height="6" Fill="{StaticResource BrushOk}"
                                 VerticalAlignment="Top" Margin="0,5,0,0" />
                        <StackPanel Grid.Column="1" Margin="9,0,0,0">
                            <TextBlock Text="LOCAL-FIRST" FontFamily="Bahnschrift SemiBold" FontSize="10"
                                       Foreground="{StaticResource BrushTextOnDark}" />
                            <TextBlock Text="敏感数据默认仅在本机处理" FontSize="11"
                                       Foreground="{StaticResource BrushTextOnDarkMuted}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Work area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="82" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource BrushSurface1}"
                    BorderBrush="{StaticResource BrushSurface2}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="安全检测工作台" FontFamily="Bahnschrift SemiBold"
                                   FontSize="20" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="资产发现 · 规则匹配 · 风险复核" FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" VerticalAlignment="Center" Padding="11,7"
                            CornerRadius="5" Background="{StaticResource BrushAccentSoft}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource BrushAccent}"
                                     VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="本地安全模式" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushAccentHover}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Margin="28,22,28,24"
                            Content="{Binding CurrentView}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:NewScanViewModel}">
                        <views:NewScanView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                        <views:HistoryView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:RuleManagementViewModel}">
                        <views:RuleManagementView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:LlmSettingsViewModel}">
                        <views:LlmSettingsView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:CoverageViewModel}">
                        <views:CoverageView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ScanProgressViewModel}">
                        <views:ScanProgressView />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>

            <Border Grid.RowSpan="2" Panel.ZIndex="20"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="440" Margin="20"
                    Padding="14,12"
                    CornerRadius="7"
                    Background="#FFF6E8"
                    BorderBrush="{StaticResource BrushWarn}"
                    BorderThickness="1"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="操作未完成" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushWarn}" />
                        <TextBlock Text="{Binding ErrorMessage}" Margin="0,4,8,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="关闭"
                            Command="{Binding DismissErrorCommand}"
                            MinWidth="54" Padding="8,4"
                            VerticalAlignment="Top" />
                </Grid>
            </Border>
        </Grid>

        <!-- Operational status strip -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BrushSurface1}"
                BorderBrush="{StaticResource BrushSurface2}" BorderThickness="0,1,0,0"
                Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource BrushOk}" Margin="0,0,5,0" />
                    <TextBlock Style="{StaticResource StatusBarLabelStyle}" Text="{StaticResource StatusRuleVersion}" />
                    <TextBlock Style="{StaticResource StatusBarItemStyle}" Text="{Binding RulePackageVersion}" />
                    <Separator Width="1" Margin="9,5" Background="{StaticResource BrushSurface3}" />
                    <TextBlock Style="{StaticResource StatusBarLabelStyle}" Text="{StaticResource StatusSandbox}" />
                    <TextBlock Style="{StaticResource StatusBarItemStyle}" Text="{Binding SandboxHealth}" />
                    <Separator Width="1" Margin="9,5" Background="{StaticResource BrushSurface3}" />
                    <TextBlock Style="{StaticResource StatusBarLabelStyle}" Text="{StaticResource StatusLlm}" />
                    <TextBlock Style="{StaticResource StatusBarItemStyle}" Text="{Binding LlmState}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource StatusBarItemStyle}" Foreground="{StaticResource BrushWarn}"
                               Text="{StaticResource WarningNonLatestRule}"
                               Visibility="{Binding NonLatestRuleWarning, Converter={StaticResource BooleanToVisibility}}" />
                    <TextBlock Style="{StaticResource StatusBarLabelStyle}" Text="{StaticResource StatusAppVersion}" />
                    <TextBlock Style="{StaticResource StatusBarItemStyle}" Text="{Binding AppVersion}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
